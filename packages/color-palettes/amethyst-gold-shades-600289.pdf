<!-- Google-Style Favorites Widget -->
<div class="favorites-widget hidden" id="favoritesWidget">
    <!-- Folder Icon Button -->
    <button class="favorites-icon-btn" id="favoritesIconBtn" onclick="toggleFavoritesPanel()">
        <i class="fas fa-folder"></i>
        <span class="favorites-badge" id="favoritesBadge">0</span>
    </button>
    
    <!-- Expanded Panel -->
    <div class="favorites-panel" id="favoritesPanel">
        <div class="favorites-panel-header">
            <div class="favorites-panel-title">
                <i class="fas fa-folder-open"></i>
                <h3>My Collection</h3>
            </div>
            <button class="favorites-close-btn" onclick="closeFavoritesPanel()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <div class="favorites-panel-content">
            <div class="favorites-count-display">
                <div class="favorites-count-icon">
                    <i class="fas fa-heart"></i>
                </div>
                <div class="favorites-count-text">
                    <div class="favorites-count-number" id="favoritesCountNumber">0</div>
                    <div class="favorites-count-label">Saved Palettes</div>
                </div>
            </div>
            
            <a href="https://icolorpalette.com/color-palette-collection" class="favorites-view-btn" id="favoritesViewBtn">
                <span>View Collection</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
    
    <!-- Toast Notification -->
    <div class="favorites-toast" id="favoritesToast">
        <i class="fas fa-check-circle"></i>
        <span>Added to collection</span>
    </div>
</div>

<script type="speculationrules">
