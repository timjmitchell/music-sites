<style>
#loginModal .modal-content {
  border: none;
}
#loginModal .btn-outline-secondary:hover {
  background-color: #f8f9fa;
  border-color: #dee2e6;
}
#loginModal .icp-login-form input[type="text"],
#loginModal .icp-login-form input[type="password"],
#loginModal .icp-login-form input[type="email"] {
  border-radius: 8px;
  padding: 12px 15px;
  border: 1px solid #dee2e6;
  width: 100%;
  margin-bottom: 12px;
  transition: border-color 0.2s, box-shadow 0.2s;
}
#loginModal .icp-login-form input:focus {
  border-color: #36A2EB;
  box-shadow: 0 0 0 3px rgba(54, 162, 235, 0.15);
  outline: none;
}
#loginModal .icp-login-form input[type="submit"],
#loginModal .icp-login-form .btn-primary {
    background-color: #ff6f00;
background: linear-gradient(135deg, #ff6f00 0%, #17017a 100%);
  background-size: 200% auto;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-weight: 600;
  color: #fff;
  width: 100%;
  cursor: pointer;
  transition: background-position 0.3s ease;
}
#loginModal .icp-login-form input[type="submit"]:hover,
#loginModal .icp-login-form .btn-primary:hover {
  background-position: right center;
}
#loginModal .icp-login-form label {
  font-weight: 500;
  color: #555;
  margin-bottom: 5px;
  display: block;
  font-size: 0.9rem;
}
@media (max-width: 767px) {
  #loginModal .modal-content {
    max-width: 100%;
    margin: 10px;
  }
  #loginModal .modal-dialog {
    margin: 10px;
  }
}
</style>

