// modal window
document.addEventListener('DOMContentLoaded', function() {
    // Get ALL elements that should trigger the login modal
    const loginTriggers = document.querySelectorAll('[data-target="#loginModal"]');
    const loginModal = document.getElementById('loginModal');
    
    if (loginModal) {
        // Add click event to all triggers
        loginTriggers.forEach(function(trigger) {
            trigger.addEventListener('click', function(e) {
                e.preventDefault();
                loginModal.style.display = 'block';
                loginModal.classList.add('show');
                document.body.classList.add('modal-open');
            });
        });
        
        // Close modal when clicking close button
        const closeBtns = loginModal.querySelectorAll('.close, [data-dismiss="modal"]');
        closeBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                closeModal();
            });
        });
        
        // Close modal when clicking outside
        loginModal.addEventListener('click', function(e) {
            if (e.target === loginModal) {
                closeModal();
            }
        });
        
        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && loginModal.classList.contains('show')) {
                closeModal();
            }
        });
        
        function closeModal() {
            loginModal.style.display = 'none';
            loginModal.classList.remove('show');
            document.body.classList.remove('modal-open');
        }
    }
});
</script>
