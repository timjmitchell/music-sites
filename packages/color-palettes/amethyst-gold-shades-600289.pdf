<style>
.favorites-notification {
    position: fixed;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    background: #323232;
    color: white;
    padding: 14px 24px;
    border-radius: 4px;
    box-shadow: 0 3px 5px -1px rgba(0,0,0,0.2), 
                0 6px 10px 0 rgba(0,0,0,0.14), 
                0 1px 18px 0 rgba(0,0,0,0.12);
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 99999;
    transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    max-width: 568px;
    min-width: 344px;
}

.favorites-notification.show {
    bottom: 24px;
}

.notification-content {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
}

.notification-icon {
    font-size: 24px;
    color: #ffc107;
}

.notification-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.notification-message {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
}

.notification-count {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 16px;
}

.notification-count strong {
    color: #ffc107;
    font-weight: 600;
}

.notification-action {
    color: #4285f4;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.25px;
    text-transform: uppercase;
    padding: 8px 12px;
    border-radius: 4px;
    transition: background-color 0.2s;
}

.notification-action:hover {
    background-color: rgba(66, 133, 244, 0.12);
    color: #5a9bff;
}

.notification-close {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    padding: 8px;
    margin: -8px -8px -8px 0;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
}

.notification-close:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
}

.notification-close i {
    font-size: 18px;
}

/* Mobile responsive */
@media (max-width: 600px) {
    .favorites-notification {
        left: 8px;
        right: 8px;
        transform: none;
        min-width: auto;
        max-width: none;
        padding: 12px 16px;
    }
    
    .favorites-notification.show {
        bottom: 8px;
    }
    
    .notification-content {
        gap: 12px;
    }
    
    .notification-icon {
        font-size: 20px;
    }
    
    .notification-action {
        font-size: 13px;
        padding: 6px 8px;
    }
}
</style>
